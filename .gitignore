# Android / Capacitor local setup and generated files
# Keep the native Android project in Git; ignore only machine-local and build output.
/android/.gradle/
/android/.gradle_home/
/android/.idea/
/android/.kotlin/
/android/.cxx/
/android/.externalNativeBuild/
/android/local.properties
/android/**/build/
/android/**/captures/
/android/**/.classpath
/android/**/.project
/android/**/.settings/
/android/**/*.iml
/android/**/*.apk
/android/**/*.aab
/android/**/*.aar
/android/**/*.jks
/android/**/*.keystore

# Files regenerated by `npx cap sync android`
/android/capacitor-cordova-android-plugins/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml

# Optional: keep only source files in repo, not generated digital assets if they are created locally
assets/*.generated.*
